--- !u!114 &1724167398
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1724167396}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 40
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 300
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Zusammenfassung der Spielregeln\n\nZiel des Spiels\nDurch das geschickte
    Platzieren von G\xE4stek\xE4rtchen an Tischen und an der Bar m\xF6glichst viele
    Punkte sammeln. Wer am Ende die meisten Punkte hat, gewinnt.\n\n\n\nSpielkomponenten\n1
    Spielplan mit 24 Tischen (je 4 Pl\xE4tze) und einer Bar (20 Pl\xE4tze)\n100 G\xE4stek\xE4rtchen
    (je 48 Damen & Herren aus 12 Nationen + 4 Joker)\nPunkte-Chips (1, 5, 10 Punkte)\n\n\nSpielablauf\nJeder
    Spieler hat 5 G\xE4stek\xE4rtchen. Reihum kann ein Spieler eine der folgenden
    Aktionen ausf\xFChren:\n-1\u20132 G\xE4stek\xE4rtchen an Tischen ablegen\n-1
    G\xE4stek\xE4rtchen an der Bar ablegen\n-1 Joker gegen passendes G\xE4stek\xE4rtchen
    austauschen\n\nEs gelten Regeln f\xFCr Nationalit\xE4t und Geschlechterverh\xE4ltnis
    (max. 2 Damen + 2 Herren pro Tisch)\n\nPunkte je nach Kombination:\nUnterschiedliche
    Nationalit\xE4ten: 2\u20134 Punkte pro K\xE4rtchen\nGleiche Nationalit\xE4t:
    4\u20138 Punkte pro K\xE4rtchen\nKein Platz n\xF6tig, aber Bar bringt meist Minuspunkte,\nJoker
    d\xFCrfen nicht an die Bar.\nKein Punktgewinn, keine Nachziehkarte.\n\nNach dem
    Ablegen werden G\xE4stek\xE4rtchen nachgezogen, bis man wieder 5 hat. Ausnahme:
    Wenn ein Tisch aus einer Nation vollendet wurde, darf man weniger nachziehen.\n\n\nSpielende\nDas
    Spiel endet, wenn eine der folgenden Bedingungen eintritt:\n\nAlle St\xFChle
    sind belegt\n\nBarplatz ist belegt\n\nEin Spieler hat keine Karten mehr\n\nNur
    noch 3 K\xE4rtchen im Beutel\n\nAm Ende werden Punkte-Chips gez\xE4hlt, Minuspunkte
    f\xFCr verbliebene G\xE4stek\xE4rtchen (\u22125) und Joker (\u221210) abgezogen.\n\n\nVariante:
    Kaffeekr\xE4nzchen & Stammtisch\n4 Damen oder 4 Herren auf einmal legen erlaubt\n\n20
    Punkte (unterschiedliche Nationen) bzw. 40 Punkte (gleiche Nation)\n\n"
